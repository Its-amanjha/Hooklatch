{
  "name": "hooklatch",
  "version": "1.0.0",
  "description": "Portable webhook signature verification with a zero-dependency core",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Its-amanjha/Hooklatch.git"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/cjs/index.cjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "hooklatch": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./dist/node/index.d.ts",
          "default": "./dist/node/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.cts",
          "default": "./dist/cjs/index.cjs"
        }
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./diagnostics": {
      "node": {
        "import": {
          "types": "./dist/node/diagnostics/index.d.ts",
          "default": "./dist/node/diagnostics/index.js"
        },
        "require": {
          "types": "./dist/cjs/diagnostics/index.d.cts",
          "default": "./dist/cjs/diagnostics/index.cjs"
        }
      },
      "types": "./dist/diagnostics/index.d.ts",
      "import": "./dist/diagnostics/index.js",
      "default": "./dist/diagnostics/index.js"
    },
    "./express": {
      "node": {
        "import": {
          "types": "./dist/node/adapters/express.d.ts",
          "default": "./dist/node/adapters/express.js"
        },
        "require": {
          "types": "./dist/cjs/adapters/express.d.cts",
          "default": "./dist/cjs/adapters/express.cjs"
        }
      },
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js",
      "default": "./dist/adapters/express.js"
    },
    "./nextjs": {
      "node": {
        "import": {
          "types": "./dist/node/adapters/nextjs.d.ts",
          "default": "./dist/node/adapters/nextjs.js"
        },
        "require": {
          "types": "./dist/cjs/adapters/nextjs.d.cts",
          "default": "./dist/cjs/adapters/nextjs.cjs"
        }
      },
      "types": "./dist/adapters/nextjs.d.ts",
      "import": "./dist/adapters/nextjs.js",
      "default": "./dist/adapters/nextjs.js"
    },
    "./cloudflare": {
      "node": {
        "import": {
          "types": "./dist/node/adapters/cloudflare.d.ts",
          "default": "./dist/node/adapters/cloudflare.js"
        },
        "require": {
          "types": "./dist/cjs/adapters/cloudflare.d.cts",
          "default": "./dist/cjs/adapters/cloudflare.cjs"
        }
      },
      "types": "./dist/adapters/cloudflare.d.ts",
      "import": "./dist/adapters/cloudflare.js",
      "default": "./dist/adapters/cloudflare.js"
    },
    "./hono": {
      "node": {
        "import": {
          "types": "./dist/node/adapters/hono.d.ts",
          "default": "./dist/node/adapters/hono.js"
        },
        "require": {
          "types": "./dist/cjs/adapters/hono.d.cts",
          "default": "./dist/cjs/adapters/hono.cjs"
        }
      },
      "types": "./dist/adapters/hono.d.ts",
      "import": "./dist/adapters/hono.js",
      "default": "./dist/adapters/hono.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cli.json && node scripts/phase11/build-node-distribution.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "typecheck:workers": "tsc -p tsconfig.workers.json --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "npm test -- --coverage",
    "lint": "npm run lint:eslint && npm run lint:anti-slop",
    "test:workers": "node scripts/workers-smoke.mjs && node scripts/workers-providers.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "test:templates": "node scripts/templates-smoke.mjs",
    "lint:eslint": "eslint src tests scripts examples --no-error-on-unmatched-pattern",
    "lint:anti-slop": "oxlint --config .oxlintrc.json src tests scripts examples",
    "test:mutations": "node scripts/phase6-mutations.mjs --include-controls",
    "test:public-contracts": "node scripts/public-contract-smoke.mjs",
    "test:provider-config": "node scripts/phase7-config-qualification.mjs --json",
    "test:configured-templates": "node scripts/phase7-cli-config-smoke.mjs",
    "test:crypto-runtime": "node scripts/phase9-runtime-qualification.mjs --json",
    "test:docs-contract": "node scripts/phase10/docs-contract-controls.mjs && node scripts/phase10/docs-contract.mjs",
    "test:api-freeze": "node scripts/phase10/api-freeze.mjs --self-test && node scripts/phase10/api-freeze.mjs --results notes/phase-10/coordinator-api-freeze-results.json",
    "test:generated-runtime": "node scripts/phase10/generated-handlers-runtime.mjs --controls && node scripts/phase10/generated-handlers-runtime.mjs --runtime current",
    "test:conformance": "node scripts/phase10/provider-conformance-controls.mjs && node scripts/phase10/provider-conformance.mjs --controls",
    "test:cjs-prototype": "node scripts/phase10/cjs-consumers.mjs",
    "test:node-distribution": "node --test tests/build/phase11-node-distribution.test.mjs",
    "test:compat-package": "node scripts/phase11/package-contract.mjs --self-test && node scripts/phase11/package-contract.mjs",
    "test:compat-types": "node scripts/phase11/types-compatibility.mjs --self-test && node scripts/phase11/types-compatibility.mjs",
    "test:compat-runtime": "node scripts/phase11/mixed-format-runtime.mjs --self-test && node scripts/phase11/mixed-format-runtime.mjs --current",
    "test:compat-frameworks": "node scripts/phase11/workers-compatibility.mjs --self-test"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.29.1"
    }
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "express": "5.3.0",
    "hono": "4.13.13",
    "jest": "30.5.2",
    "miniflare": "4.20260730.0",
    "oxlint": "1.89.0",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "homepage": "https://github.com/Its-amanjha/Hooklatch#readme",
  "bugs": {
    "url": "https://github.com/Its-amanjha/Hooklatch/issues"
  },
  "keywords": [
    "webhooks",
    "signature-verification",
    "hmac",
    "ed25519",
    "typescript",
    "express",
    "hono",
    "nextjs",
    "cloudflare-workers"
  ]
}
