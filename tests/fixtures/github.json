{
  "cases": [
    {
      "id": "reference-vector-2026-10-18",
      "provenance": { "class": "reference", "source": "https://docs.github.com/en/webhooks/using-webhooks/validating-webhook-deliveries; secret/payload/expected all published in the official docs page" },
      "request": {
        "bodyBase64": "SGVsbG8sIFdvcmxkIQ==",
        "headers": {
          "x-hub-signature-256": "sha256=757107ea0eb2509fc211221cce984b8a37570b6d7586c22c46f4379c8b043e17",
          "x-github-delivery": "a1b2c3d4-0000-4e2f-9f6a-000000000001",
          "x-github-event": "ping"
        }
      },
      "options": { "secrets": ["It's a Secret to Everybody"], "toleranceSeconds": 300, "now": 4102444800 },
      "expected": { "ok": true, "identity": { "deliveryId": "unsigned-or-null", "eventId": null, "timestamp": null, "authenticatedFields": [] } }
    },
    {
      "id": "uppercase-hex-of-reference-vector",
      "provenance": { "class": "local", "source": "reference-vector signature rendered uppercase hex; contract v1 decodes hex case-insensitively; original vector in official docs URL above" },
      "request": {
        "bodyBase64": "SGVsbG8sIFdvcmxkIQ==",
        "headers": {
          "x-hub-signature-256": "sha256=757107EA0EB2509FC211221CCE984B8A37570B6D7586C22C46F4379C8B043E17",
          "x-github-delivery": "a1b2c3d4-0000-4e2f-9f6a-000000000001"
        }
      },
      "options": { "secrets": ["It's a Secret to Everybody"], "toleranceSeconds": 300, "now": 4102444800 },
      "expected": { "ok": true, "identity": { "deliveryId": "unsigned-or-null", "eventId": null, "timestamp": null, "authenticatedFields": [] } }
    },
    {
      "id": "mixed-case-header-name-parity",
      "provenance": { "class": "local", "source": "same reference vector with mixed-case header names; case-insensitive lookup keeps the verdict" },
      "request": {
        "bodyBase64": "SGVsbG8sIFdvcmxkIQ==",
        "headers": {
          "X-Hub-Signature-256": "sha256=757107EA0EB2509FC211221CCE984B8A37570B6D7586C22C46F4379C8B043E17",
          "X-GitHub-Delivery": "a1b2c3d4-0000-4e2f-9f6a-000000000001"
        }
      },
      "options": { "secrets": ["It's a Secret to Everybody"], "toleranceSeconds": 300, "now": 4102444800 },
      "expected": { "ok": true, "identity": { "deliveryId": "unsigned-or-null", "eventId": null, "timestamp": null, "authenticatedFields": [] } }
    },
    {
      "id": "wrong-secret-anchor",
      "provenance": { "class": "local", "source": "HMAC-SHA256 of the same published payload under the wrong synthetic secret 'It's not the Secret to Everybody' computed with node:crypto" },
      "request": {
        "bodyBase64": "SGVsbG8sIFdvcmxkIQ==",
        "headers": {
          "x-hub-signature-256": "sha256=db7d04fabeb267313d8a2eb5e0d91d28cfeb54b371f9bf6296ad3321c5dd705a",
          "x-github-delivery": "a1b2c3d4-0000-4e2f-9f6a-000000000001"
        }
      },
      "options": { "secrets": ["It's a Secret to Everybody"], "toleranceSeconds": 300, "now": 4102444800 },
      "expected": { "ok": false, "reason": "invalid-signature" }
    },
    {
      "id": "body-tamper",
      "provenance": { "class": "local", "source": "published vector signature replayed over a different body" },
      "request": {
        "bodyBase64": "eyJpZCI6ImV2dF8xVGVybkZpeHR1cmVBIiwib2JqZWN0IjoiZXZlbnQiLCJ0eXBlIjoicGF5bWVudF9pbnRlbnQuc3VjY2VlZGVkIiB9",
        "headers": {
          "x-hub-signature-256": "sha256=757107ea0eb2509fc211221cce984b8a37570b6d7586c22c46f4379c8b043e17",
          "x-github-delivery": "a1b2c3d4-0000-4e2f-9f6a-000000000001"
        }
      },
      "options": { "secrets": ["It's a Secret to Everybody"], "toleranceSeconds": 300, "now": 4102444800 },
      "expected": { "ok": false, "reason": "invalid-signature" }
    },
    {
      "id": "truncated-signature",
      "provenance": { "class": "local", "source": "first 4 hex bytes of the published vector; malformed-signature reason ratified during integration" },
      "request": {
        "bodyBase64": "SGVsbG8sIFdvcmxkIQ==",
        "headers": { "x-hub-signature-256": "sha256=7571" }
      },
      "options": { "secrets": ["It's a Secret to Everybody"], "toleranceSeconds": 300, "now": 4102444800 },
      "expected": { "ok": false, "reason": "malformed-signature" }
    },
    {
      "id": "sha1-leftover-only",
      "provenance": { "class": "local", "source": "legacy HMAC-SHA1 X-Hub-Signature header only; contract v1 covers GitHub SHA-256; primary aligned with the current descriptor mapping observed 2026-10-18; exact reason ratified during integration" },
      "request": {
        "bodyBase64": "SGVsbG8sIFdvcmxkIQ==",
        "headers": { "x-hub-signature": "sha1=0000000000000000000000000000000000000000" }
      },
      "options": { "secrets": ["It's a Secret to Everybody"], "toleranceSeconds": 300, "now": 4102444800 },
      "expected": { "ok": false, "reason": "unsupported-scheme" }
    },
    {
      "id": "unsigned-delivery-header-change",
      "provenance": { "class": "local", "source": "reference vector with a different X-GitHub-Delivery; the delivery ID is unsigned metadata and must not change the verdict nor become authenticated identity" },
      "request": {
        "bodyBase64": "SGVsbG8sIFdvcmxkIQ==",
        "headers": {
          "x-hub-signature-256": "sha256=757107ea0eb2509fc211221cce984b8a37570b6d7586c22c46f4379c8b043e17",
          "x-github-delivery": "changed-unsigned-id"
        }
      },
      "options": { "secrets": ["It's a Secret to Everybody"], "toleranceSeconds": 300, "now": 4102444800 },
      "expected": { "ok": true, "identity": { "deliveryId": "unsigned-or-null", "eventId": null, "timestamp": null, "authenticatedFields": [] } }
    },
    {
      "id": "missing-signature-header",
      "provenance": { "class": "local", "source": "no signature header (GitHub omits X-Hub-Signature-256 when the webhook has no secret configured)" },
      "request": {
        "bodyBase64": "SGVsbG8sIFdvcmxkIQ==",
        "headers": { "x-github-delivery": "a1b2c3d4-0000-4e2f-9f6a-000000000001" }
      },
      "options": { "secrets": ["It's a Secret to Everybody"], "toleranceSeconds": 300, "now": 4102444800 },
      "expected": { "ok": false, "reason": "missing-signature" }
    }
  ]
}
